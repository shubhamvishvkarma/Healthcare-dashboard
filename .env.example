# --- Hospital Database Configuration Template ---
# Rename this file to '.env' and fill in your real credentials.

# Database Type (sqlite, postgresql, mssql, mysql)
HOSPITAL_DB_TYPE=sqlite

# Connection Details
HOSPITAL_DB_USER=hospital_admin
HOSPITAL_DB_PASSWORD=your_secure_password
HOSPITAL_DB_HOST=192.168.1.100
HOSPITAL_DB_NAME=healthcare.db
HOSPITAL_DB_PORT=5432

# Note: For SQLite, only HOSPITAL_DB_NAME is required.
